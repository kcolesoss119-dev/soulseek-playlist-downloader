# Let Git handle normal text files automatically.
*          text=auto

# Keep Windows (CRLF) line endings exactly as they are in these files.
# "-text" tells Git never to convert their line endings, so the .bat and
# .ps1 files always download with the CRLF endings Windows expects.
# (These lines must stay BELOW the "*" line so they take priority.)
*.bat      -text
*.cmd      -text
*.ps1      -text
*.example  -text
Playlists/*.txt -text
